# Test-only additions to the pinned Android common arm64 gki_defconfig.
# The virtual transport and drivers must be ready before guest-entry inventories sysfs.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_BSG=y

# Use a distinct release; never load the pinned GKI prebuilt modules into this Image.
CONFIG_LOCALVERSION="-android13-fuxi-p63-g24d27dff64c4"
# CONFIG_LOCALVERSION_AUTO is not set
