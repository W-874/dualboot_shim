+fn reject_skyward_guest_destructive_operation() -> binder::Result<()> {
+    match rustutils::android::system_properties::read("ro.skyward.guest") {
+        Ok(value) if value.as_deref() != Some("true") => Ok(()),
+        Ok(_) => Err(binder::Status::new_service_specific_error(ErrorCode::UNIMPLEMENTED.0, None)),
+        Err(e) => {
+            error!("Failed to read guest product property: {e:?}");
+            Err(binder::Status::new_service_specific_error(ErrorCode::UNKNOWN_ERROR.0, None))
+        }
+    }
+}
