+static bool ConsumeSkywardMkfsToken() {
+    constexpr char kTokenName[] = "skyward-mkfs-v2";
+    constexpr std::string_view kTokenContents = "v2\n";
+
+    // Use O_PATH on /metadata: vold needs to traverse it, not read it.
+    android::base::unique_fd metadata_fd(
+            open("/metadata", O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (metadata_fd < 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot open /metadata";
+        return false;
+    }
+    android::base::unique_fd dir_fd(
+            openat(metadata_fd, "vold", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (dir_fd < 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot open /metadata/vold";
+        return false;
+    }
+    struct stat st;
+    if (fstat(dir_fd, &st) != 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot stat /metadata/vold";
+        return false;
+    }
+    if (st.st_uid != 0 || st.st_gid != 0 || (st.st_mode & 07777) != 0700) {
+        LOG(ERROR) << "Skyward mkfs: /metadata/vold must be root:root with mode 0700";
+        return false;
+    }
+
+    android::base::unique_fd token_fd(
+            openat(dir_fd, kTokenName, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+    if (token_fd < 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot open format token " << kTokenName;
+        return false;
+    }
+    if (fstat(token_fd, &st) != 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot stat format token";
+        return false;
+    }
+    if (!S_ISREG(st.st_mode) || st.st_uid != 0 || st.st_gid != 0 || st.st_nlink != 1 ||
+        (st.st_mode & 07777) != 0600 || st.st_size != static_cast<off_t>(kTokenContents.size())) {
+        LOG(ERROR) << "Skyward mkfs: unsafe format token (type, ownership, links, mode, or size)";
+        return false;
+    }
+    char contents[kTokenContents.size() + 1];
+    const auto size = TEMP_FAILURE_RETRY(read(token_fd, contents, sizeof(contents)));
+    if (size < 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot read format token";
+        return false;
+    }
+    if (std::string_view(contents, size) != kTokenContents) {
+        LOG(ERROR) << "Skyward mkfs: invalid format token contents";
+        return false;
+    }
+
+    // The publisher runs before init; the root-only parent prevents unprivileged replacement.
+    // Keep the directory pinned for both removal and persistence of the one-shot grant.
+    if (unlinkat(dir_fd, kTokenName, 0) != 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot unlink format token";
+        return false;
+    }
+    if (TEMP_FAILURE_RETRY(fsync(dir_fd)) != 0) {
+        PLOG(ERROR) << "Skyward mkfs: cannot persist format token removal";
+        return false;
+    }
+    LOG(INFO) << "Skyward mkfs: consumed format token for encrypted /data";
+    return true;
+}
